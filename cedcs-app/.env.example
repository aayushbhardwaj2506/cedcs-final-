# ---- copy to .env (git-ignored). Never commit real keys. ----
# LLM (Groq). Without it the system runs rule-based. Per-stage overrides: CEDCS_LLM_MODEL_INTAKE / _TRIAGE / _EXPLANATION
GROQ_API_KEY=
# Second LLM provider (NVIDIA NIM, https://build.nvidia.com). With both keys the agents share the load and fail over to each other.
NVIDIA_API_KEY=
# CEDCS_LLM_PROVIDERS=groq,nvidia    # restrict to one provider if you like
# CEDCS_MODE=auto        # auto | groq | offline | crewai
# Address search + routed travel times (LocationIQ). Without it: straight-line ETAs, no address search.
LOCATIONIQ_KEY=
# Hospital data. Neon (or any Postgres+PostGIS); seed once with:  python resource_service/seed.py
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Where the API finds the resource service
RESOURCE_SERVICE_URL=http://127.0.0.1:8000
# ---- Emergency dispatch (see README). Default is a DRY RUN: nothing is e-mailed, everything is logged in the app's outbox.
# DISPATCH_MODE=outbox           # outbox (default) | smtp
# SMTP_HOST=smtp.example.com     # real sending needs all four of these
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# DISPATCH_TEST_INBOX=you@yours.com   # sandbox: redirect EVERY message here (recommended for first real tests)
# IMAP_HOST= / IMAP_USER= / IMAP_PASSWORD=   # optional: read hospital replies ("ACCEPT"/"DECLINE") from a mailbox
# PUBLIC_BASE_URL=http://127.0.0.1:8001      # where hospitals' confirmation links point; must be reachable by them
ADMIN_TOKEN=change-me           # required to change admin settings (bed checker, auto-dispatch)
# RESOURCE_WRITE_KEY=           # optional shared secret protecting the resource service's bed write endpoints
# CACHE_REFRESH_S=30     # resource service in-memory refresh interval; 0 = query the DB on every request

# Run history (optional). Default: Neon via HISTORY_DATABASE_URL or DATABASE_URL, else a local file. CEDCS_HISTORY=off disables.
# HISTORY_DATABASE_URL=postgresql://...
# CEDCS_HISTORY=on
# HISTORY_MAX_RUNS=2000
